# ===== Binance =====
# Public market data works without keys, but keys allow higher rate limits
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
DAILY_ANALYSIS_CHANNEL_ID=
TRADES_CHANNEL_ID=
ADMIN_USER_IDS=123456789,987654321

# ===== AI Provider =====
# Choose one: openai or anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ===== Database =====
# For local SQLite testing use: sqlite:///trading.db
# For production use Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///trading.db

# ===== Trading =====
INITIAL_CAPITAL=10000
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_TRADES=5
MIN_RISK_REWARD=2.0

# ===== Optional =====
COINGECKO_API_KEY=
LOG_LEVEL=INFO
TIMEZONE=Asia/Riyadh
